# Environment variables (server-side only, read by Netlify Functions).
# Set these in the Netlify dashboard as secret values. Never use a REACT_APP_
# prefix for keys: Create React App bundles those into the public JS.

# NEWS_API_KEY=        # newsapi.org key (news-proxy function)
# ANTHROPIC_API_KEY=   # Anthropic key (ai-verify function)

# Optional cost caps (shared by ai-verify and news-proxy; redeploy after changing)
# AI_PER_IP_DAILY=     # calls per visitor per UTC day
# AI_GLOBAL_DAILY=     # calls per UTC day across all visitors
